{
  "name": "jmail",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src-app/main.ts",
  "build": {
    "icon": "assets/icon",
    "appId": "jynio.jmail",
    "files": [
      "src-app/crypt/**/*",
      "src-app/db/**/*",
      "src-app/dist/**/*",
      "src-app/interfaces/**/*",
      "src-app/ipcs/**/*",
      "src-app/main.ts",
      "src-app/preload.ts",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "/public/favicon.ico"
    },
    "directories": {
      "output": "release"
    },
    "asar": true
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "start": "electron .",
    "rebuild": "npx electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "electron": "^43.2.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
